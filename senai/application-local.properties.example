# Copie este arquivo para application-local.properties e preencha os valores locais.
# application-local.properties nao deve ser commitado.

# Evolution API local
app.whatsapp.enabled=false
app.whatsapp.api-url=http://localhost:8081
app.whatsapp.api-key=
app.whatsapp.instance=consorcio

# O frontend configura Gmail e senha de app em PUT /api/configuracoes/email.
# As credenciais ficam apenas na memoria do backend e precisam ser enviadas novamente apos reiniciar.
app.mail.enabled=false
spring.mail.username=
spring.mail.password=

# Token local de desenvolvimento do backend
app.security.dev-token-enabled=true
app.security.dev-token=token-local-123
app.integration.api-key=integration-local-123