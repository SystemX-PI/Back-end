# Optional local overrides. Compose has development defaults for Evolution.
# Use your own secrets before exposing this environment.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
EVOLUTION_API_KEY=replace-with-a-random-key
EVOLUTION_DB_PASSWORD=replace-with-a-random-password
EVOLUTION_PORT=8081

# Platform Gmail sender for password recovery. Use a Google app password.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe subscriptions (configure only after creating the monthly BRL Price in Stripe)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_CENTS=0
STRIPE_SUCCESS_URL=http://localhost:5173/app/assinatura?stripe=success
STRIPE_CANCEL_URL=http://localhost:5173/app/upgrade?stripe=cancelled
